{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "organization",
          "url",
          "retrieved_at",
          "category",
          "status",
          "normative_or_informative",
          "license_or_usage_notes",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
